# Copy to .env (same directory) and fill in real values before running
# `docker compose up`. Never commit the real .env file.

# Bootstrap/admin Postgres role — owns the schema, runs Flyway migrations.
# Not used by the running application (see docs/adr/0001-multitenant-rls.md).
DB_MIGRATION_USERNAME=controle_de_gastos_admin
DB_MIGRATION_PASSWORD=change-me

# Restricted, non-superuser role the application actually connects as.
# Created by infra/postgres/init/01-create-app-role.sh on first boot.
DB_PASSWORD=change-me

# HMAC signing key for JWTs — must be at least 32 bytes, unique per environment.
JWT_SECRET=change-me-to-a-long-random-value

# Comma-separated list of origins allowed to call the API (the PWA's URL).
CORS_ALLOWED_ORIGINS=http://localhost

# Web Push (VAPID). The pair below is a real, working dev-only key pair
# generated for this project — fine for local testing, but generate a fresh
# pair per real environment (any "generate VAPID keys" tool produces a
# compatible P-256 key pair; the app just needs the raw public/private keys
# base64url-encoded, no padding).
VAPID_PUBLIC_KEY=BKSB-t7Yqcy2t9_hngjy0c8rMsPP_lRQWWnXV8RkcW0l4jIif-Tn4qeMAHUtAsaI-tFXQ7MYe5A7m5GzmuyXkKo
VAPID_PRIVATE_KEY=Rzyf4-UoQkTYFFXn2D69IqHxKM0OqHxOZ3g7m9T1iis
VAPID_SUBJECT=mailto:contato@controledegastos.local
